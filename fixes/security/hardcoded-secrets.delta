// fix: Detect hardcoded secrets and credentials
// lang: TypeScript, JavaScript
// severity: security
// Flags hardcoded API keys, passwords, tokens, and connection strings.
// Replaces them with environment variable lookups.

// ─── Guard: no hardcoded secrets ─────────────────────────────────────────
guard "no-hardcoded-secrets" {
  scope:   "src/**"
  assert:  no file contains "apiKey" near "=" near quoted_string
  assert:  no file contains "password" near "=" near quoted_string
  assert:  no file contains "secret" near "=" near quoted_string
  assert:  no file contains "token" near "=" near quoted_string
  on_fail: block_apply, warn
}

// ─── Fix: hardcoded API key → env var ────────────────────────────────────
fix hardcodedApiKey {
  pattern: { const $NAME = "$VALUE" }
  replace: { const $NAME = process.env.$NAME ?? "" }
  scope:   "src/**/*.ts"
  severity: security
  note:    "Never hardcode credentials. Use environment variables."
}

// ─── Trace: track where env vars flow to ensure they are not logged ───────
trace envSecrets in "src/" {
  language: TypeScript
  origin:   process.env
  follow:   assignments, function_calls, returns
  report:   summary
  flag:     "any path that reaches console.log"
  flag:     "any path that reaches logger.info"
  flag:     "any path that reaches res.json without sanitize"
}

apply fix hardcodedApiKey to project preview
